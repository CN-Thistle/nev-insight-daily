# 将本文件复制为 .dev.vars，用于 wrangler dev 本地调试。
# 线上敏感值请使用 `wrangler secret put`，不要提交真实密钥。

GITHUB_TOKEN=github_pat_replace_me
MANUAL_TRIGGER_TOKEN=replace_with_a_long_random_string

GITHUB_OWNER=CN-Thistle
GITHUB_REPO=nev-insight-daily
GITHUB_BRANCH=main
GITHUB_API_VERSION=2022-11-28
GITHUB_COMMITTER_NAME=NEV Daily Bot
GITHUB_COMMITTER_EMAIL=nev-daily-bot@users.noreply.github.com

AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
ARTICLE_TIME_ZONE=Asia/Shanghai
LOOKBACK_HOURS=36
MAX_ITEMS_PER_SOURCE=8
MAX_ARTICLES=15
FETCH_TIMEOUT_MS=12000

# 可选。必须是一行合法 JSON；留空时使用 index.js 内置 RSS 源。
RSS_SOURCES_JSON=
